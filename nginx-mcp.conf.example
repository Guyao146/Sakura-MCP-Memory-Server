# Replace mcp.example.com with your domain. TLS is mandatory in production.
server {
    listen 443 ssl http2;
    server_name mcp.example.com;

    # ssl_certificate /etc/letsencrypt/live/mcp.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/mcp.example.com/privkey.pem;
    client_max_body_size 6m;
    server_tokens off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Keep the public host when proxying. Without this, application host
    # validation sees 127.0.0.1:3001 and can reject setup/admin requests.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Single trusted edge: discard client-supplied forwarding chains.
    # Multi-proxy deployments must configure real_ip from explicit trusted CIDRs first.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Authorization $http_authorization;

    location = / {
        proxy_pass http://127.0.0.1:3001;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
    }
    location = /mcp {
        proxy_pass http://127.0.0.1:3001;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
    }
    location = /setup { proxy_pass http://127.0.0.1:3001; }
    location = /assets/setup.js { proxy_pass http://127.0.0.1:3001; }
    location = /assets/management.js { proxy_pass http://127.0.0.1:3001; }
    location ^~ /api/setup/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_read_timeout 30s;
    }
    location ^~ /auth/ { proxy_pass http://127.0.0.1:3001; }
    location = /admin { proxy_pass http://127.0.0.1:3001; }
    location = /api/me { proxy_pass http://127.0.0.1:3001; }
    location ^~ /api/me/ { proxy_pass http://127.0.0.1:3001; }
    # Stream large downloads without buffering them into proxy temp files.
    location = /api/admin/exports {
        proxy_pass http://127.0.0.1:3001;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
    }
    location ^~ /api/admin/ { proxy_pass http://127.0.0.1:3001; }
    location = /health { proxy_pass http://127.0.0.1:3001; access_log off; }
    location = /.well-known/oauth-protected-resource { proxy_pass http://127.0.0.1:3001; }
    location = /.well-known/oauth-protected-resource/mcp { proxy_pass http://127.0.0.1:3001; }
}
