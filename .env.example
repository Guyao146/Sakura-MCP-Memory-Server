# Public HTTPS URL and local listener.
PUBLIC_BASE_URL=https://mcp.example.com
# Production image. Use SAKURA_MCP_IMAGE=sakura-mcp-server:local only with docker-compose.dev.yml.
SAKURA_MCP_IMAGE=ghcr.io/guyao146/sakura-mcp-server:0.3.0
HOST=0.0.0.0
PORT=3000
MCP_HOST_PORT=3001
LOG_LEVEL=info

# Authentication is enabled by default. Set AUTH=false (or auth=false) only on a private,
# access-restricted network: every visitor becomes the local system administrator.
AUTH=true

# PostgreSQL 16 + pgvector. The Compose value works inside its network.
DATABASE_URL=postgresql://sakura:replace-database-password@postgres:5432/sakura_memory
POSTGRES_HOST=sakura-mcp-server-postgres
DATABASE_MAX_CONNECTIONS=20
AUTO_MIGRATE=true
POSTGRES_PASSWORD=replace-database-password

# Permanent 32-byte key used to encrypt Provider credentials.
# Losing CONFIG_ENCRYPTION_KEY makes encrypted settings unrecoverable.
CONFIG_ENCRYPTION_KEY=replace-with-32-byte-base64url-key

# Optional bootstrap/emergency keys. Normal Agent keys are created after installation,
# returned once, SHA-256 hashed in PostgreSQL, scoped, expirable and revocable.
# Remove bootstrap keys after Authentik administration is working.
# Format: id:secret:scope|scope, entries separated by commas.
MCP_API_KEYS=bootstrap-admin:replace-with-32-byte-random-secret:memory:read|memory:write|memory:update|memory:delete|memory:export|space:create|space:manage|member:manage|agent:manage|admin:system

# Authentik JWT validation (required when AUTH=true; ignored when AUTH=false).
AUTHENTIK_ISSUER=https://login.example.com/application/o/sakura-mcp/
AUTHENTIK_AUDIENCE=https://mcp.example.com
AUTHENTIK_JWKS_URI=https://login.example.com/application/o/sakura-mcp/jwks/
AUTHENTIK_SCOPE_CLAIM=scope

# Optional OpenAI-compatible Chat and Embedding provider.
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_CHAT_MODEL=
OPENAI_COMPATIBLE_EMBEDDING_MODEL=

# Optional local Ollama provider.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=
OLLAMA_EMBEDDING_MODEL=

# Optional dedicated Embedding endpoint (OpenAI-compatible). Use this when the Chat
# provider/relay does not offer embeddings. When set, vectors use this endpoint,
# independent from the Chat provider above.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# PostgreSQL-backed background worker. Multiple replicas are safe.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=2000
WORKER_STALE_AFTER_SECONDS=900

# Security. Enable TRUST_PROXY only when the app is reachable exclusively through a trusted proxy.
TRUST_PROXY=false
RATE_LIMIT_MCP_PER_MINUTE=120
RATE_LIMIT_WEB_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_SETUP_PER_MINUTE=10

AUDIT_LOG_PATH=/app/data/audit.jsonl