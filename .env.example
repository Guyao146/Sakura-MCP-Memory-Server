# Public HTTPS URL and local listener.
PUBLIC_BASE_URL=https://mcp.example.com
# Production image. The legacy SAKURA_MCP_IMAGE override is still accepted by Compose.
# Use SAKURA_MCP_MEMORY_IMAGE=sakura-mcp-memory-server:local only with docker-compose.dev.yml.
SAKURA_MCP_MEMORY_IMAGE=ghcr.io/guyao146/sakura-mcp-memory-server:0.5.1
# Existing installations: read docs/rename-migration.md before starting the renamed project.
# Keep both existing volumes via docker-compose.legacy-data.yml; never delete or recreate keys.
# SAKURA_MEMORY_POSTGRES_VOLUME=sakura-mcp-memory-server_postgres-data
# SAKURA_MEMORY_SECRETS_VOLUME=sakura-mcp-memory-server_runtime-secrets
HOST=0.0.0.0
PORT=3000
MCP_HOST_PORT=3001
LOG_LEVEL=info

# Authentication is enabled by default. Set AUTH=false (or auth=false) only on a private,
# access-restricted network: every visitor becomes the local system administrator.
AUTH=true

# PostgreSQL 16 + pgvector. The Compose value works inside its network.
DATABASE_URL=postgresql://sakura:replace-database-password@postgres:5432/sakura_memory
POSTGRES_HOST=sakura-mcp-memory-server-postgres
DATABASE_MAX_CONNECTIONS=20
AUTO_MIGRATE=true
POSTGRES_PASSWORD=replace-database-password

# Permanent 32-byte key used to encrypt Provider credentials.
# Losing CONFIG_ENCRYPTION_KEY makes encrypted settings unrecoverable.
CONFIG_ENCRYPTION_KEY=replace-with-32-byte-base64url-key

# Optional bootstrap/emergency keys. Normal Agent keys are created after installation,
# returned once, SHA-256 hashed in PostgreSQL, scoped, expirable and revocable.
# Remove bootstrap keys after Authentik administration is working.
# Format: id:secret:scope|scope, entries separated by commas.
MCP_API_KEYS=bootstrap-admin:replace-with-32-byte-random-secret:memory:read|memory:write|memory:update|memory:delete|memory:export|space:create|space:manage|member:manage|agent:manage|admin:system

# Optional Authentik configuration. Leave empty when using local accounts only.
AUTHENTIK_ISSUER=
AUTHENTIK_AUDIENCE=
AUTHENTIK_JWKS_URI=
AUTHENTIK_SCOPE_CLAIM=scope
# Browser login additionally requires these three fields, or setup/admin UI configuration.
AUTHENTIK_CLIENT_ID=
AUTHENTIK_AUTHORIZATION_URL=
AUTHENTIK_TOKEN_URL=

# Optional Sakura-Auth-Server browser login. Leave empty to disable it.
# Example issuer: https://sakura.example.com ; JWKS: https://sakura.example.com/jwks.json
# Audience must equal the registered Client ID. Configure adminGroups in the UI.
# Current Sakura email is unverified and cannot grant administrator privileges.
# Sakura access tokens are NOT MCP credentials; use a scoped Agent Key for MCP.
SAKURA_ISSUER=
SAKURA_AUDIENCE=
SAKURA_JWKS_URI=
SAKURA_SCOPE_CLAIM=groups
SAKURA_CLIENT_ID=
SAKURA_AUTHORIZATION_URL=
SAKURA_TOKEN_URL=
# Optional /logout confirmation page; no automatic post-logout redirect support.
SAKURA_END_SESSION_URL=

# Local login: username/password accounts stored in this server's database.
# Without any AUTHENTIK_*/SAKURA_* variables, local login is on by default; with
# an external OIDC provider configured, set LOCAL_LOGIN=true to offer both
# methods on the login page.
# Accounts can also be created in the setup wizard or via /api/admin/local-users.
LOCAL_LOGIN=true
# Optional administrator provisioned on every boot; changing the password and
# restarting rotates it. Leave empty to manage accounts only after installation.
LOCAL_ADMIN_USERNAME=
LOCAL_ADMIN_PASSWORD=

# Optional OpenAI-compatible Chat and Embedding provider.
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_CHAT_MODEL=
OPENAI_COMPATIBLE_EMBEDDING_MODEL=

# Optional local Ollama provider.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=
OLLAMA_EMBEDDING_MODEL=

# Optional dedicated Embedding endpoint (OpenAI-compatible). Use this when the Chat
# provider/relay does not offer embeddings. When set, vectors use this endpoint,
# independent from the Chat provider above.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# PostgreSQL-backed background worker. Multiple replicas are safe.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=2000
WORKER_STALE_AFTER_SECONDS=900

# Security. Enable TRUST_PROXY only when the app is reachable exclusively through a trusted proxy.
# Raw request bytes, checked before JSON parsing (6 MiB); align reverse-proxy limits too.
MAX_REQUEST_BODY_BYTES=6291456
TRUST_PROXY=false
RATE_LIMIT_MCP_PER_MINUTE=120
RATE_LIMIT_WEB_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_SETUP_PER_MINUTE=10

AUDIT_LOG_PATH=/app/data/audit.jsonl